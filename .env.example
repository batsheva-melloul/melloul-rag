# --- LLM provider selection ---
# "azure" (production) or "gemini" (free tier). Default: gemini.
LLM_PROVIDER=azure

# --- Azure OpenAI (production provider) ---
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-small

# --- Gemini (free-tier fallback provider) ---
GEMINI_API_KEY=your_gemini_key_here

# --- Demo mode (backend) ---
# true = NO authentication (for quick LAN demos only). Leave false/unset for real use.
DEMO_MODE=false

# --- SSL verification ---
# Set to true ONLY on a corporate network that does SSL inspection (else HTTPS
# calls fail). In the cloud, leave this unset so SSL verification stays ON.
DISABLE_SSL_VERIFY=false

# --- SharePoint sync (Microsoft Graph, app-only) ---
AZURE_TENANT_ID=d3dda2aa-21d1-41c6-8bfc-edfdd80dcb83
AZURE_CLIENT_ID=62ddfafb-ea62-4e6f-abaf-254af76b35d6
AZURE_CLIENT_SECRET=paste_the_client_secret_VALUE_here
SHAREPOINT_HOSTNAME=melloulil.sharepoint.com
# Each corpus's site_path is configured per-chatbot in corpora.py